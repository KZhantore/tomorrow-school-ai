// hashcode
func HashCode(dec string) string {
	n := len(dec)
	result := make([]byte, n)
	for i := 0; i < n; i++ {
		val := (int(dec[i]) + n) % 127
		if val < 32 {
			val += 33
		}
		result[i] = byte(val)
	}
	return string(result)
}

