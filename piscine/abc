func ItoaBase(value, base int) string {
    if value == 0 {
        return "0"
    }
    digits := "0123456789ABCDEF"
    negative := value < 0
    if negative {
        value = -value
    }
    result := ""
    for value > 0 {
        result = string(digits[value%base]) + result
        value /= base
    }
    if negative {
        result = "-" + result
    }
    return result
}
```

