### 40. `FifthAndSkip` — каждые 5 символов разделить пробелом, 6-й удалить

**Пробелы в строке игнорируются при подсчёте 5 символов.**

```go
func FifthAndSkip(str string) string {
    if str == "" {
        return "\n"
    }
    // Собрать все непробельные символы
    chars := []rune{}
    for _, c := range str {
        chars = append(chars, c)
    }
    if len(chars) < 5 {
        return "Invalid Input\n"
    }
    result := ""
    i := 0
    group := 0
    skip := false
    for i < len(chars) {
        if chars[i] == ' ' {
            i++
            continue
        }
        if skip {
            // пропускаем 6-й символ
            i++
            skip = false
            group = 0
            if i < len(chars) {
                result += " "
            }
            continue
        }
        result += string(chars[i])
        group++
        i++
        if group == 5 {
            skip = true
        }
    }
    return result + "\n"
}
```

