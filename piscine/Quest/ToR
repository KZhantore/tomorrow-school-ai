// findprevprime — first prime <= nb
func IsPrime(n int) bool {
	if n < 2 {
		return false
	}
	for i := 2; i*i <= n; i++ {
		if n%i == 0 {
			return false
		}
	}
	return true
}

func FindPrevPrime(nb int) int {
	for nb >= 2 {
		if IsPrime(nb) {
			return nb
		}
		nb--
	}
	return 0
}

// fromto — range string with zero-padding
func FromTo(from int, to int) string {
	if from < 0 || from > 99 || to < 0 || to > 99 {
		return "Invalid\n"
	}
	var parts []string
	if from <= to {
		for i := from; i <= to; i++ {
			parts = append(parts, fmt.Sprintf("%02d", i))
		}
	} else {
		for i := from; i >= to; i-- {
			parts = append(parts, fmt.Sprintf("%02d", i))
		}
	}
	return strings.Join(parts, ", ") + "\n"
}

