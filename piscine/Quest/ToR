// canjump — can reach end following exact steps
func CanJump(nums []uint) bool {
	if len(nums) == 0 {
		return false
	}
	if len(nums) == 1 {
		return true
	}
	pos := 0
	for pos < len(nums)-1 {
		step := int(nums[pos])
		next := pos + step
		if next >= len(nums) {
			return false
		}
		if next == len(nums)-1 {
			return true
		}
		pos = next
	}
	return pos == len(nums)-1
}

