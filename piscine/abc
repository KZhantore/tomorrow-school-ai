### 41. `NotDecimal` — удалить десятичную точку, умножив на 10^n

**Примеры:** `"0.1"` → `"1"`, `"174.2"` → `"1742"`, `"1952"` → `"1952"`

```go
func NotDecimal(dec string) string {
    if dec == "" {
        return "\n"
    }
    dotIdx := strings.Index(dec, ".")
    if dotIdx == -1 {
        return dec + "\n"
    }
    // Всё что после точки
    after := dec[dotIdx+1:]
    // Убрать trailing zeros
    for len(after) > 0 && after[len(after)-1] == '0' {
        after = after[:len(after)-1]
    }
    if after == "" {
        return dec[:dotIdx] + "\n"
    }
    // Проверить что after содержит только цифры
    for _, c := range after {
        if c < '0' || c > '9' {
            return dec + "\n"
        }
    }
    return dec[:dotIdx] + after + "\n"
}
```

