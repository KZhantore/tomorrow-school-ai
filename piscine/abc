### 26. `WeAreUnique` — уникальные символы в двух строках

**Считает символы, которые есть только в одной из строк (без повторений).**

```go
func WeAreUnique(str1, str2 string) int {
    if str1 == "" && str2 == "" {
        return -1
    }
    seen := make(map[rune]bool)
    inBoth := make(map[rune]bool)
    
    for _, c := range str1 {
        seen[c] = true
    }
    for _, c := range str2 {
        if seen[c] {
            inBoth[c] = true
        }
    }
    
    unique := make(map[rune]bool)
    for _, c := range str1 {
        if !inBoth[c] {
            unique[c] = true
        }
    }
    for _, c := range str2 {
        if !inBoth[c] {
            unique[c] = true
        }
    }
    return len(unique)
}
```

