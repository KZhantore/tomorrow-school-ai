// concatalternate — alternate two slices, larger first
func ConcatAlternate(slice1, slice2 []int) []int {
	var result []int
	l1, l2 := len(slice1), len(slice2)
	i, j := 0, 0

	if l1 >= l2 {
		// Equal or slice1 larger: interleave s1,s2,s1,s2... then append rest of s1
		for i < l1 || j < l2 {
			if i < l1 {
				result = append(result, slice1[i])
				i++
			}
			if j < l2 {
				result = append(result, slice2[j])
				j++
			}
		}
	} else {
		// slice2 larger: interleave s2,s1,s2,s1... then append rest of s2
		for i < l1 || j < l2 {
			if j < l2 {
				result = append(result, slice2[j])
				j++
			}
			if i < l1 {
				result = append(result, slice1[i])
				i++
			}
		}
	}
	return result
}

