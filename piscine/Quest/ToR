// fprime — prime factorisation (program)
func FPrime(n int) string {
	if n <= 1 {
		return ""
	}
	var factors []string
	for i := 2; i*i <= n; i++ {
		for n%i == 0 {
			factors = append(factors, strconv.Itoa(i))
			n /= i
		}
	}
	if n > 1 {
		factors = append(factors, strconv.Itoa(n))
	}
	return strings.Join(factors, "*")
}

