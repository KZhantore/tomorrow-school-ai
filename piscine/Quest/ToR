// fifthandskip — every 5 chars (skip spaces to count) separated by space, remove 6th
func FifthAndSkip(str string) string {
	if str == "" {
		return "\n"
	}
	// Count non-space chars to determine length
	nonSpace := 0
	for _, c := range str {
		if c != ' ' {
			nonSpace++
		}
	}
	if nonSpace < 5 {
		return "Invalid Input\n"
	}

	// Build groups: collect 5 non-space chars, then skip 1 non-space
	var groups []string
	var current strings.Builder
	count := 0 // non-space count in current group
	skipping := false
	skipCount := 0

	for _, c := range str {
		if c == ' ' {
			continue
		}
		if skipping {
			skipCount++
			if skipCount == 1 {
				skipping = false
				skipCount = 0
				// start new group
				current.Reset()
				count = 0
				current.WriteRune(c)
				count++
			}
			continue
		}
		current.WriteRune(c)
		count++
		if count == 5 {
			groups = append(groups, current.String())
			current.Reset()
			count = 0
			skipping = true
		}
	}
	if current.Len() > 0 {
		groups = append(groups, current.String())
	}
	return strings.Join(groups, " ") + "\n"
}

// notdecimal — remove decimal point by multiplying
func NotDecimal(dec string) string {
	dec = strings.TrimSpace(dec)
	if dec == "" {
		return "\n"
	}
	dotIdx := strings.Index(dec, ".")
	if dotIdx == -1 {
		return dec + "\n"
	}
	intPart := dec[:dotIdx]
	fracPart := dec[dotIdx+1:]

	// Check if all chars are digits (or leading minus for intPart)
	checkStr := intPart
	if len(checkStr) > 0 && checkStr[0] == '-' {
		checkStr = checkStr[1:]
	}
	for _, c := range checkStr {
		if !unicode.IsDigit(c) {
			return dec + "\n"
		}
	}
	for _, c := range fracPart {
		if !unicode.IsDigit(c) {
			return dec + "\n"
		}
	}

	// Remove trailing zeros from fracPart
	trimFrac := strings.TrimRight(fracPart, "0")
	if trimFrac == "" {
		return intPart + "\n"
	}

	// Combine int and frac without dot
	negative := false
	numStr := intPart
	if len(numStr) > 0 && numStr[0] == '-' {
		negative = true
		numStr = numStr[1:]
	}
	combined := numStr + trimFrac
	// Remove leading zeros
	combined = strings.TrimLeft(combined, "0")
	if combined == "" {
		combined = "0"
	}
	if negative {
		combined = "-" + combined
	}
	return combined + "\n"
}

// revconcatalternate — reverse alternate two slices (largest elements first from back)
func RevConcatAlternate(slice1, slice2 []int) []int {
	l1, l2 := len(slice1), len(slice2)
	i, j := l1-1, l2-1
	var result []int

	if l1 >= l2 {
		// equal or slice1 longer: start with slice1
		for i >= 0 || j >= 0 {
			if i >= 0 {
				result = append(result, slice1[i])
				i--
			}
			if j >= 0 {
				result = append(result, slice2[j])
				j--
			}
		}
	} else {
		// slice2 longer: drain extra from slice2 first
		extra := l2 - l1
		for k := l2 - 1; k >= extra; k-- {
			_ = k // will be handled below
		}
		// Actually: interleave from the right, starting from the longer side
		for i >= 0 || j >= 0 {
			if j >= 0 && (j-i) > 0 {
				result = append(result, slice2[j])
				j--
			} else {
				if i >= 0 {
					result = append(result, slice1[i])
					i--
				}
				if j >= 0 {
					result = append(result, slice2[j])
					j--
				}
			}
		}
	}
	return result
}

