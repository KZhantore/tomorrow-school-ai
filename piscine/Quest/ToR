	if strings.ContainsRune(vowels, rune(word[0])) {
		return word + "ay"
	}
	// Find first vowel
	firstVowel := -1
	for i, c := range word {
		if strings.ContainsRune(vowels, c) {
			firstVowel = i
			break
		}
	}
	if firstVowel == -1 {
		return "No vowels"
	}
	return word[firstVowel:] + word[:firstVowel] + "ay"
}

