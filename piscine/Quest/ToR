// itoabase — convert int to string in given base (2-16)
func ItoaBase(value, base int) string {
	if base < 2 || base > 16 {
		return ""
	}
	if value == 0 {
		return "0"
	}
	digits := "0123456789ABCDEF"
	negative := value < 0
	if negative {
		value = -value
	}
	var result []byte
	for value > 0 {
		result = append([]byte{digits[value%base]}, result...)
		value /= base
	}
	if negative {
		result = append([]byte{'-'}, result...)
	}
	return string(result)
}

// options — parse -xyz flags into a 32-bit int, print as bytes
func Options(args []string) {
	if len(args) == 0 {
		fmt.Println("options: abcdefghijklmnopqrstuvwxyz")
		return
	}
	var flags uint32
	printHelp := false

	for _, arg := range args {
		if len(arg) < 2 || arg[0] != '-' {
			fmt.Println("Invalid Option")
			return
		}
		for _, c := range arg[1:] {
			if c == 'h' {
				printHelp = true
			} else if c >= 'a' && c <= 'z' {
				flags |= 1 << uint(c-'a')
			} else {
				fmt.Println("Invalid Option")
				return
			}
		}
		if printHelp {
			break
		}
	}

	if printHelp {
		fmt.Println("options: abcdefghijklmnopqrstuvwxyz")
		return
	}

	fmt.Printf("%08b %08b %08b %08b\n",
		(flags>>24)&0xFF,
		(flags>>16)&0xFF,
		(flags>>8)&0xFF,
		flags&0xFF)
}

