### 14. `LastWord` — последнее слово строки

```go
func LastWord(s string) string {
    // Убрать пробелы в конце
    end := len(s) - 1
    for end >= 0 && s[end] == ' ' {
        end--
    }
    start := end
    for start >= 0 && s[start] != ' ' {
        start--
    }
    if end < 0 {
        return "\n"
    }
    return s[start+1:end+1] + "\n"
}
```

