### 51. `brackets` — проверить правильность скобок

**Алгоритм:** стек. При открывающей скобке — push, при закрывающей — pop и проверить соответствие.

```go
func isBalanced(s string) bool {
    stack := []rune{}
    pairs := map[rune]rune{')': '(', ']': '[', '}': '{'}
    for _, c := range s {
        if c == '(' || c == '[' || c == '{' {
            stack = append(stack, c)
        } else if c == ')' || c == ']' || c == '}' {
            if len(stack) == 0 || stack[len(stack)-1] != pairs[c] {
                return false
            }
            stack = stack[:len(stack)-1]
        }
    }
    return len(stack) == 0
}
```

