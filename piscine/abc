### 15. `RepeatAlpha` — повторить каждую букву по её порядку в алфавите

`'a'` → 1 раз, `'b'` → 2 раза, ..., `'z'` → 26 раз. Регистр не важен для подсчёта.

```go
func RepeatAlpha(s string) string {
    result := ""
    for _, c := range s {
        if c >= 'a' && c <= 'z' {
            count := int(c-'a') + 1
            for i := 0; i < count; i++ {
                result += string(c)
            }
        } else if c >= 'A' && c <= 'Z' {
            count := int(c-'A') + 1
            for i := 0; i < count; i++ {
                result += string(c)
            }
        } else {
            result += string(c)
        }
    }
    return result
}
```

