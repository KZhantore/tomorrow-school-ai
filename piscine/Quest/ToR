// zipstring — run-length encode
func ZipString(s string) string {
	if s == "" {
		return s
	}
	var result strings.Builder
	runes := []rune(s)
	i := 0
	for i < len(runes) {
		c := runes[i]
		count := 1
		for i+count < len(runes) && runes[i+count] == c {
			count++
		}
		result.WriteString(strconv.Itoa(count))
		result.WriteRune(c)
		i += count
	}
	return result.String()
}

