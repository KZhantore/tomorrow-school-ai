// cameltosnakecase — CamelCase → snake_case
func CamelToSnakeCase(s string) string {
	if s == "" {
		return s
	}
	// Validate camelCase rules
	// No digits/punctuation, no two consecutive uppercase, must not end uppercase
	for _, c := range s {
		if !unicode.IsLetter(c) {
			return s
		}
	}
	runes := []rune(s)
	n := len(runes)
	// No two consecutive uppercase
	for i := 1; i < n; i++ {
		if unicode.IsUpper(runes[i]) && unicode.IsUpper(runes[i-1]) {
			return s
		}
	}
	// Must not end with uppercase
	if unicode.IsUpper(runes[n-1]) {
		return s
	}
	var result []rune
	for i, c := range runes {
		if unicode.IsUpper(c) && i != 0 {
			result = append(result, '_')
		}
		result = append(result, unicode.ToLower(c))
	}
	return string(result)
}

